node_modules/

# the openly licensed libraries (~400 MB); `just soundfonts` downloads them
soundfonts/
.DS_Store

# Claude Code: worktrees, personal settings and the preview's launch config
.claude/

# the A/B listening tool: old versions to compare against, and its renders
.ab/

# reference music for tools/nsf (not ours to redistribute)
reference/

# your own files (sketches, takes, notes): kept on this machine, never committed
scratch/
# a project's takes: the audio stays local, the notes read from it are kept in the project
projects/**/*.wav

# the bundled UI; `just build` makes it
dist/

# icon renders on the way to assets/icon/; `just icons` makes them
build/

# release builds; `just package` makes them
release/
